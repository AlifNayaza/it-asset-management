datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id                Int       @id @default(autoincrement())
  name              String    @unique @db.VarChar(100)
  useful_life_years Int       @default(4)
  salvage_percentage Decimal  @default(5.00) @db.Decimal(5, 2)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  assets            Asset[]

  @@map("categories")
}

model Location {
  id          Int      @id @default(autoincrement())
  branch_name String   @db.VarChar(100)
  room_name   String   @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  assets      Asset[]

  @@map("locations")
}

model Asset {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_tag         String            @unique @db.VarChar(50)
  serial_number     String            @unique @db.VarChar(100)
  model_name        String            @db.VarChar(150)
  category_id       Int
  location_id       Int?
  status            String            @db.VarChar(20) // 'available', 'assigned', 'maintenance', 'retired', 'lost'
  purchase_date     DateTime          @db.Date
  purchase_price    Decimal           @db.Decimal(15, 2)
  useful_life_years Int               @default(4)
  salvage_value     Decimal           @default(0.00) @db.Decimal(15, 2)
  current_holder    String?           @db.VarChar(150)
  image_url         String?           @db.VarChar(255)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  category          Category          @relation(fields: [category_id], references: [id], onDelete: Restrict)
  location          Location?         @relation(fields: [location_id], references: [id], onDelete: SetNull)
  assignments       AssetAssignment[]
  maintenance_logs  MaintenanceLog[]

  @@map("assets")
}

model AssetAssignment {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id               String    @db.Uuid
  employee_name          String    @db.VarChar(150)
  employee_id_number     String    @db.VarChar(50)
  assigned_at            DateTime  @default(now()) @db.Timestamptz(6)
  returned_at            DateTime? @db.Timestamptz(6)
  condition_on_checkout  String    @db.Text
  condition_on_return    String?   @db.Text
  handover_doc_path      String?   @db.VarChar(255)
  assigned_by            String    @db.VarChar(100)
  notes                  String?   @db.Text

  asset                  Asset     @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@map("asset_assignments")
}

model MaintenanceLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id          String    @db.Uuid
  service_date      DateTime  @db.Date
  completion_date   DateTime? @db.Date
  vendor_name       String    @db.VarChar(150)
  issue_description String    @db.Text
  cost              Decimal   @default(0.00) @db.Decimal(15, 2)
  invoice_path      String?   @db.VarChar(255)
  logged_by         String    @db.VarChar(100)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  asset             Asset     @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@map("maintenance_logs")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  table_name     String   @db.VarChar(50)
  record_id      String   @db.VarChar(50)
  action_type    String   @db.VarChar(20) // 'INSERT', 'UPDATE', 'DELETE'
  changed_by     String   @db.VarChar(100)
  payload_before Json?    @db.JsonB
  payload_after  Json?    @db.JsonB
  logged_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("audit_logs")
}
